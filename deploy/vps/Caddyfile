# HTTPS entry point. SITE_ADDRESS is a host name pointing at the server, e.g.
# 80-43-0-155.sslip.io (free, no domain needed) or api.yourdomain.com.
# Caddy obtains and renews the Let's Encrypt certificate automatically.

{$SITE_ADDRESS} {
	encode zstd gzip

	# REST API used by the web dashboard and the mobile app
	handle /api/* {
		reverse_proxy api:3000
	}

	# Web dashboard
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_REPL_USER=repl_user
POSTGRES_REPL_PASSWORD=myreplpassword
PGPOOL_ADMIN_USER=admin
PGPOOL_ADMIN_PASSWORD=adminsecret

# AI Processing
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication
# Required. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated emails allowed to see the WhatsApp QR / reset the bot session
ADMIN_EMAILS=you@example.com

# SMTP Configuration
# Ethereal (https://ethereal.email) is a FAKE inbox for testing: emails never reach Gmail etc.;
# the API logs a preview URL for each one. For real delivery via Gmail use an App Password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=you@gmail.com   SMTP_PASS=<16-char app password>  SMTP_FROM="WhatsMonTrack <you@gmail.com>"
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_password
SMTP_SECURE=false

SMTP_FROM=

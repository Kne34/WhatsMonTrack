# Production settings for docker-compose.prod.yml (VPS). See deploy/vps/README.md.
# On the server: cp .env.prod.example .env.prod && nano .env.prod   (.env.prod is git-ignored)

# Host name for HTTPS. Without a domain use <ip-with-dashes>.sslip.io, e.g. 80-43-0-155.sslip.io
SITE_ADDRESS=80-43-0-155.sslip.io

# Generate both: openssl rand -hex 32   (database password) / openssl rand -hex 48   (JWT)
POSTGRES_PASSWORD=
JWT_SECRET=

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Emails allowed to see the bot QR and reset the bot (comma-separated)
ADMIN_EMAILS=you@example.com

# OTP email: EITHER Brevo's HTTPS API ...
BREVO_API_KEY=
MAIL_FROM=WhatsMonTrack <you@example.com>
# ... OR SMTP, e.g. Gmail with an App Password (used when BREVO_API_KEY is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=WhatsMonTrack <you@gmail.com>

# Process WhatsApp messages sent while the bot was down, up to this many hours old
WA_OFFLINE_MAX_AGE_HOURS=72

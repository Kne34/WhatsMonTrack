// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Money: whole rupiah stored as BIGINT (exact integer, no float drift; IDR has no minor unit in use).
// Read as JS bigint; convert with Number() for arithmetic (safe up to ~9e15).

model User {
  id                 String        @id @default(uuid())
  phoneNumber        String?       @unique // linked WhatsApp number, canonical 62xxxxxxxxxx (see common/phone.ts)
  email              String        @unique
  password           String        // bcrypt hash
  isVerified         Boolean       @default(false)
  otpCode            String?
  otpExpiresAt       DateTime?
  otpAttempts        Int           @default(0)
  // Linking a WhatsApp number: the user sends "VERIFIKASI <phoneLinkCode>" to the bot from that number
  phoneLinkCode      String?       @unique
  phoneLinkExpiresAt DateTime?
  pendingPhone       String?       // optional: number the user said they would link from
  defaultCurrency    String        @default("IDR")
  /// IANA zone used for day/month boundaries and times in bot replies (timestamps are stored in UTC)
  timezone           String        @default("Asia/Jakarta")
  createdAt          DateTime      @default(now())

  accounts           Account[]
  transactions       Transaction[]
  budgets            Budget[]
  chatMessages       ChatMessage[]
  debtNotes          DebtNote[]
  investments        Investment[]
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  DEBT_OUT
  DEBT_IN
}

enum TransactionStatus {
  CONFIRMED
  NEEDS_REVIEW
}

model Account {
  id               String        @id @default(uuid())
  userId           String
  name             String
  balance          BigInt        @default(0)

  user             User          @relation(fields: [userId], references: [id])
  transactionsFrom Transaction[] @relation("FromAccount")
  transactionsTo   Transaction[] @relation("ToAccount")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  type            TransactionType   @default(EXPENSE)
  amount          BigInt
  category        String
  subcategory     String?
  /// Person a lending/debt transaction (category DEBT) is with, e.g. "Budi"
  counterparty    String?
  fromAccountId   String?
  toAccountId     String?
  rawText         String?
  /// WhatsApp message id this was recorded from: makes re-delivered messages idempotent
  sourceMessageId String?           @unique
  confidenceScore Float             @default(1.0)
  status          TransactionStatus @default(CONFIRMED)
  createdAt       DateTime          @default(now())

  user            User      @relation(fields: [userId], references: [id])
  fromAccount     Account?  @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount       Account?  @relation("ToAccount", fields: [toAccountId], references: [id])

  @@index([userId, category])
}

model Budget {
  id           String @id @default(uuid())
  userId       String
  categoryName String
  limit        BigInt @default(0)

  user         User   @relation(fields: [userId], references: [id])
  @@unique([userId, categoryName])
}

/// WhatsApp (Baileys) session: credentials and signal keys, one row per key.
/// Kept in the database so the bot survives restarts on hosts without a persistent disk.
model WhatsAppAuth {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

/// Web chat with the bot (same conversation logic as WhatsApp, for users without a bot number).
model ChatMessage {
  id        String   @id @default(uuid())
  userId    String
  fromBot   Boolean  @default(false)
  text      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

/// Utang-piutang page: a to-do style list of who owes whom. Notes only; it never changes balances.
model DebtNote {
  id        String   @id @default(uuid())
  userId    String
  /// The other person, e.g. "Budi"
  person    String
  /// THEY_OWE: the person owes the user. I_OWE: the user owes the person.
  direction String
  amount    BigInt
  /// Paid back so far; settled when paid >= amount
  paid      BigInt   @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Investasi page: one row per asset the user holds on a platform (e.g. BBCA on Stockbit).
/// Separate from accounts and transactions: buying or selling here never changes balances.
model Investment {
  id          String   @id @default(uuid())
  userId      String
  /// IDX_STOCK | US_STOCK | CRYPTO
  assetType   String
  /// As the user types it, upper case: BBCA, AAPL, BTC (no .JK suffix)
  symbol      String
  name        String?
  /// CoinGecko coin id for crypto, e.g. "bitcoin"
  coingeckoId String?
  /// Free text: Stockbit, Pluang, Bibit, ...
  platform    String
  /// Currency of the buy price: IDR or USD (IDX stocks are always IDR)
  currency    String
  /// IDX stocks: lots (1 lot = 100 shares). US stocks and crypto: units, fractions allowed.
  quantity    Decimal  @db.Decimal(30, 10)
  /// Average buy price per share/unit, in `currency`
  avgPrice    Decimal  @db.Decimal(30, 10)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades      InvestmentTrade[]

  @@index([userId])
}

/// Buy/sell history of a holding. Buys recompute the average price; sells record the realized P&L.
model InvestmentTrade {
  id           String     @id @default(uuid())
  investmentId String
  /// BUY | SELL
  side         String
  /// Same unit as Investment.quantity (lots for IDX stocks)
  quantity     Decimal    @db.Decimal(30, 10)
  /// Price per share/unit, in the holding's currency
  price        Decimal    @db.Decimal(30, 10)
  /// Sells only: (price - average price) x shares, in the holding's currency
  realizedPnl  Decimal?   @db.Decimal(30, 10)
  note         String?
  tradedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())

  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId, tradedAt])
}

/// Last known market prices, shared by all users. The fallback when Yahoo Finance or CoinGecko fail.
model MarketPrice {
  /// e.g. "IDX:BBCA", "US:AAPL", "CRYPTO:bitcoin", "FX:USDIDR"
  key       String   @id
  price     Decimal  @db.Decimal(30, 10)
  /// Currency of `price`: IDR or USD. Crypto rows keep the IDR price in `priceIdr` too.
  currency  String
  priceIdr  Decimal? @db.Decimal(30, 10)
  name      String?
  updatedAt DateTime @updatedAt
}

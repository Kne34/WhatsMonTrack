# Production image of the API + WhatsApp bot (used by docker-compose.prod.yml).
# The development image is ./Dockerfile (hot reload, migrations through pgpool).
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --include=dev
COPY . .
RUN npx prisma generate && npx nest build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production \
    NODE_OPTIONS=--dns-result-order=ipv4first
# The Prisma CLI (a dev dependency) is kept: migrations are applied on start
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/prisma.config.ts /app/package.json ./
# Files stay owned by root (read-only for the app); nothing is written at runtime
USER node
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main"]

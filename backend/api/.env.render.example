# Environment for the API on Render (free plan). See DEPLOY.md.
# Render dashboard -> your service -> Environment -> "Add from .env" -> paste this file with real values.
# Copy to .env.render (git-ignored) and fill in the blanks; never commit real values.

NODE_VERSION=22
NODE_OPTIONS=--dns-result-order=ipv4first

# Neon "pooled" connection string (host contains -pooler); keep ?sslmode=require, drop &channel_binding=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon "direct" connection string (connection pooling off, no -pooler); used only for migrations
MIGRATE_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Emails allowed to see the bot QR and reset the bot (comma-separated)
ADMIN_EMAILS=you@example.com

# OTP email via Brevo's HTTPS API (Render's free plan blocks SMTP).
# API key: Brevo -> SMTP & API -> API keys (starts with xkeysib-). MAIL_FROM must be a verified sender.
BREVO_API_KEY=
MAIL_FROM=WhatsMonTrack <you@example.com>

# Your Vercel URL, no trailing slash (set after the frontend is deployed)
FRONTEND_ORIGIN=https://your-app.vercel.app

# Process WhatsApp messages sent while the free instance was asleep, up to this many hours old
WA_OFFLINE_MAX_AGE_HOURS=168
# Render's load balancer in front of the API
TRUST_PROXY_HOPS=1

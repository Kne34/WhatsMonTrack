# Only needed when running the API outside Docker (docker-compose injects these from the root .env).
# prisma.config.ts loads this file via dotenv.

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgpool:5432/postgres?schema=public"

# Required. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# Comma-separated emails allowed to see the WhatsApp QR / reset the bot session
ADMIN_EMAILS=you@example.com

# AI parsing
GEMINI_API_KEY=your_gemini_api_key_here

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_password
SMTP_SECURE=false
